# Any OpenAI-compatible endpoint serving an open-source model.
# --- Option 1: local with Ollama (offline, safest for the demo) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct

# --- Option 2: Groq (free tier, very fast, open models like Llama) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_key
# LLM_MODEL=<a Llama or Qwen model listed in Groq's console>

# --- Option 3: Together AI / OpenRouter ---
# LLM_BASE_URL=https://api.together.xyz/v1   (or https://openrouter.ai/api/v1)
# LLM_API_KEY=your_key
# LLM_MODEL=<open model name from the provider's catalog>
